ROWS, COLS, WIN = 6, 12, 4

def actions(board):
    return [c for c in range(COLS) if board[0][c] == 0]

def result(board, col, joueur):
    b = [row[:] for row in board]
    for r in range(ROWS - 1, -1, -1):
        if b[r][col] == 0:
            b[r][col] = joueur
            break
    return b

def check_win(board, joueur):
    for r in range(ROWS):
        for c in range(COLS - WIN + 1):
            if all(board[r][c+k] == joueur for k in range(WIN)):
                return True
    for r in range(ROWS - WIN + 1):
        for c in range(COLS):
            if all(board[r+k][c] == joueur for k in range(WIN)):
                return True
    for r in range(ROWS - WIN + 1):
        for c in range(COLS - WIN + 1):
            if all(board[r+k][c+k] == joueur for k in range(WIN)):
                return True
    for r in range(WIN - 1, ROWS):
        for c in range(COLS - WIN + 1):
            if all(board[r-k][c+k] == joueur for k in range(WIN)):
                return True
    return False

def Terminal_Test(board):
    pieces = sum(board[r][c] != 0 for r in range(ROWS) for c in range(COLS))
    return check_win(board, 1) or check_win(board, -1) or pieces >= 42 or not actions(board)²

def heuristique(board):
    score = 0
    for r in range(ROWS):
        for c in range(COLS - 3):
            w = [board[r][c+k] for k in range(4)]
            if -1 not in w: score += w.count(1) * 2
            if 1 not in w:  score -= w.count(-1) * 2
    return score

def max_val(board, alpha, beta, depth):
    if check_win(board, 1):  return 100000
    if check_win(board, -1): return -100000
    if depth == 0 or not actions(board): return heuristique(board)
    v = float('-inf')
    for col in actions(board):
        v = max(v, min_val(result(board, col, 1), alpha, beta, depth - 1))
        if v >= beta: return v
        alpha = max(alpha, v)
    return v

def min_val(board, alpha, beta, depth):
    if check_win(board, 1):  return 100000
    if check_win(board, -1): return -100000
    if depth == 0 or not actions(board): return heuristique(board)
    v = float('inf')
    for col in actions(board):
        v = min(v, max_val(result(board, col, -1), alpha, beta, depth - 1))
        if v <= alpha: return v
        beta = min(beta, v)
    return v

def IA_Decision(board):
    best_col, best_score = actions(board)[0], float('-inf')
    for col in actions(board):
        score = min_val(result(board, col, 1), float('-inf'), float('inf'), 4)
        if score > best_score:
            best_score, best_col = score, col
    return best_col

def afficher(board):
    sym = {1: 'X', -1: 'O', 0: ' '}
    print()
    for r in range(ROWS):
        print('|' + '|'.join(sym[board[r][c]] for c in range(COLS)) + '|')
    print('-' * (COLS * 2 + 1))
    print('|' + '|'.join(str(c % 10) for c in range(COLS)) + '|')
    print()

def jouer():
    board = [[0]*COLS for _ in range(ROWS)]
    choix = input("Qui commence ? (ia/vous) : ").strip().lower()
    ia, hum = 1, -1
    tour = 1 if choix == 'ia' else -1

    while not Terminal_Test(board):
        afficher(board)
        if tour == ia:
            col = IA_Decision(board)
            print(f"L'IA joue colonne {col}")
        else:
            col = int(input(f"Votre colonne (0-11) : "))
        board = result(board, col, tour)
        tour = -tour

    afficher(board)
    if check_win(board, ia):  print("L'IA gagne !")
    elif check_win(board, hum): print("Vous gagnez !")
    else: print("Match nul !")

if name == 'main':
    jouer()
